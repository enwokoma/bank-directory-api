# Copy to deploy/.env.production on the server and fill in. git ignores it.
# No AWS keys belong here: SES uses the EC2 instance role (see docs/deploy.md).

# The API's public address, and the sign-up emails' sender.
PUBLIC_BASE_URL=https://banks.example.com
SIGNUP_EMAIL_FROM=Bank Directory API <no-reply@example.com>
# The region of the SES identity the sender belongs to, for example us-east-1.
AWS_REGION=

# Optional, with their defaults:
# ANONYMOUS_RATE_LIMIT=60 per hour;300 per day
# KEY_RATE_LIMIT=120 per minute;20000 per day
# SIGNUP_RATE_LIMIT=10 per hour;30 per day
# GUNICORN_WORKERS=3
