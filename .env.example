# Copy this file to .env and fill in the values. .env is ignored by git.
# Only `python -m src.refresh` reads these; the API itself needs no settings.

# Nigeria: an API that returns the NIBSS Instant Payment (NIP) institution list,
# as a JSON list of objects with a 6-digit code and a name (directly, or under
# "data", "banks" or "institutions"). Leave the URL empty to keep the NIBSS
# codes already in data/countries/NGA.json.
NIP_INSTITUTIONS_URL=
NIP_INSTITUTIONS_API_KEY=
# Header that carries the key. Defaults to X-API-Key.
NIP_INSTITUTIONS_KEY_HEADER=
