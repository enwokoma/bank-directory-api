# Copy this file to .env and fill in the values. .env is ignored by git.
# Only `python -m src.refresh` reads these; the API itself needs no settings.

# Nigeria: an API that returns the NIBSS Instant Payment (NIP) institution list,
# as a JSON list of objects with a 6-digit code and a name (directly, or under
# "data", "banks" or "institutions"). Leave the URL empty to keep the NIBSS
# codes already in data/countries/NGA.json.
NIP_INSTITUTIONS_URL=
NIP_INSTITUTIONS_API_KEY=
# Header that carries the key. Defaults to X-API-Key.
NIP_INSTITUTIONS_KEY_HEADER=

# Relayed copies of the list can be incomplete. More endpoints use the same
# names ending in _2 (up to _5); the lists are merged by code. For an endpoint
# that expects "Authorization: Bearer <key>", set its header to Authorization
# and put "Bearer " before the key.
NIP_INSTITUTIONS_URL_2=
NIP_INSTITUTIONS_API_KEY_2=
NIP_INSTITUTIONS_KEY_HEADER_2=

# Paystack's bank list relays the codes as nip_sort_code, but only with both
# query parameters below (country=nigeria instead of currency=NGN drops them):
#   NIP_INSTITUTIONS_URL_3=https://api.paystack.co/bank?currency=NGN&include_nip_sort_code=true
#   NIP_INSTITUTIONS_API_KEY_3=Bearer sk_...
#   NIP_INSTITUTIONS_KEY_HEADER_3=Authorization
NIP_INSTITUTIONS_URL_3=
NIP_INSTITUTIONS_API_KEY_3=
NIP_INSTITUTIONS_KEY_HEADER_3=

# An endpoint that needs a login first, such as Monnify's, takes a login URL:
# the key is then "api key:secret key", sent to that URL as Basic auth, and
# the list is read with the token the login returns.
#   NIP_INSTITUTIONS_URL_4=https://api.monnify.com/api/v1/banks
#   NIP_INSTITUTIONS_LOGIN_URL_4=https://api.monnify.com/api/v1/auth/login
#   NIP_INSTITUTIONS_API_KEY_4=MK_..:..
NIP_INSTITUTIONS_URL_4=
NIP_INSTITUTIONS_LOGIN_URL_4=
NIP_INSTITUTIONS_API_KEY_4=
NIP_INSTITUTIONS_KEY_HEADER_4=

# Flutterwave's v3 bank list gives the 6-digit NIBSS code as its own code for
# most institutions, so it relays them to the refresh like the others, and its
# 3-digit codes for banks serve `python -m src.countries.nigeria.bank_code_sources`,
# which reports the CBN bank codes every configured list gives. A list without
# NIBSS codes at all adds nothing to the refresh and only serves that report.
#   NIP_INSTITUTIONS_URL_5=https://api.flutterwave.com/v3/banks/NG
#   NIP_INSTITUTIONS_API_KEY_5=Bearer FLWSECK-...
#   NIP_INSTITUTIONS_KEY_HEADER_5=Authorization
NIP_INSTITUTIONS_URL_5=
NIP_INSTITUTIONS_API_KEY_5=
NIP_INSTITUTIONS_KEY_HEADER_5=
